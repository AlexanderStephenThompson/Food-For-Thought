{
  "conditional_tokens": {
    "extra": {
      "mode": "strip_when_next_in",
      "values": ["large"]
    },
    "kosher": {
      "mode": "strip_when_head_in",
      "values": ["salt"]
    },
    "packed": {
      "mode": "keep_when_next_in",
      "values": ["in"]
    },
    "sea": {
      "mode": "strip_when_head_in",
      "values": ["salt"]
    },
    "whole": {
      "mode": "strip_when_head_in",
      "values": ["milk"]
    }
  },
